{
  "expo": {
    "name": "Fali nam jedan",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "falinamjedan",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tarikvuk.falinamjedan",
      "supportsTablet": false
    },
    "android": {
      "package": "com.tarikvuk.falinamjedan",
      "adaptiveIcon": {
        "backgroundColor": "#0A0C0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0C0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lokacija se koristi da izabereš mjesto termina na mapi i vidiš termine u blizini."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22C55E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "39ea9365-0988-40c4-8c66-dd9ad896bc31"
      }
    },
    "owner": "tarikvuk1"
  }
}